MISTRAL_API_KEY=your_api_key_here

# Optionnel — URL de l'instance SearxNG auto-hébergée qui sert la recherche web
# du fact-checker (voir searxng/docker-compose.yml : `docker compose up -d`).
# Doit rester un hôte local : c'est le backend qui interroge SearxNG, jamais un
# moteur tiers qui voit passer les affirmations vérifiées (cf. ARCHITECTURE.md).
# Sans instance joignable, le fact-check tourne sans preuve web (dégradé, pas bloqué).
# SEARXNG_URL=http://127.0.0.1:8080

# Recommandé — clé de l'API officielle Brave Search. Sans elle, SearxNG
# interroge Brave comme un navigateur, et Brave bloque la recherche web après
# quelques dizaines de requêtes (plus aucune source pendant des heures).
# Offre gratuite : 1 requête/s. Clé à créer sur https://api-dashboard.search.brave.com,
# à coller ici (.env n'est jamais commité). SearxNG reste utilisé pour Wikipédia.
# BRAVE_API_KEY=

# Optionnel — repli IPv4. Si ta box annonce l'IPv6 sans le router, chaque
# appel sortant (Mistral, Eurostat…) perd 8 à 40 s avant de passer en IPv4.
# auto (défaut) : testé au démarrage, IPv4 forcé seulement si l'IPv6 ne passe
# pas. 1 : toujours IPv4. 0 : laisser le système décider.
# FORCE_IPV4=auto

# Optionnel — jeton partagé entre le backend et l'extension. Le backend
# n'écoute que sur 127.0.0.1 (rien depuis le réseau) et n'accepte que les
# origines chrome-extension:// (aucune page web ouverte dans le navigateur ne
# peut l'appeler) ; le jeton ajoute une barrière contre les autres
# extensions et applications locales. Si défini ici, colle la même valeur
# dans le champ "Jeton d'accès" (section Avancé) de la popup.
# BACKEND_TOKEN=un-secret-long-et-aleatoire

# Optionnel — autres origines navigateur autorisées (séparées par des
# virgules), en plus de l'extension Chrome. Vide par défaut.
# ALLOWED_ORIGINS=http://localhost:3000

# Optionnel — modèle Whisper (faster-whisper). large-v3-turbo par défaut :
# nettement meilleur que medium sur les chiffres et noms propres, ~6 Go VRAM.
# Repli automatique sur "medium" si le chargement échoue.
# WHISPER_MODEL=large-v3-turbo

# Optionnel — modèle Mistral pour l'extraction de talking points et le
# fact-checking. "medium" suit mieux le prompt d'extraction que "small".
# MISTRAL_MODEL=mistral-medium-latest

# Optionnel — modèle Mistral de l'étape de vérification seule (verdicts).
# Par défaut, le même que MISTRAL_MODEL. Essai d'octobre 2026 : Mistral Large
# était un peu plus lent (3,1 s contre 2,3 s par verdict) et MOINS fiable avec
# nos règles (bien plus de « faux » à tort) — medium reste le défaut.
# MISTRAL_FACTCHECK_MODEL=mistral-large-latest

# Optionnel — modèle Mistral de la fiche de fin de débat (résumé, moments forts,
# propositions) : un seul appel, une fois le débat fini. Par défaut, le même que
# MISTRAL_MODEL. Essai d'octobre 2026 : Large ne rédigeait pas mieux (phrases
# plus génériques, propositions prêtées au mauvais débatteur).
# MISTRAL_FICHE_MODEL=mistral-large-latest

# Optionnel — petites tâches (identification des voix, thèmes, intervenants
# d'une vidéo) : modèle local servi par Ollama (https://ollama.com), sinon petit
# modèle Mistral. Installation : winget install Ollama.Ollama, puis
# ollama pull ministral-3:8b (~6 Go). Laisser LOCAL_LLM_MODEL vide pour s'en passer.
# LOCAL_LLM_MODEL=ministral-3:8b
# LOCAL_LLM_URL=http://127.0.0.1:11434
# MISTRAL_SMALL_MODEL=mistral-small-latest

# Optionnel — device pour la diarisation (empreintes vocales ECAPA-TDNN).
# "cpu" par défaut : sur GPU, le cuDNN de torch entre en conflit avec celui
# de CTranslate2 (faster-whisper) dans le même process Windows et crash le
# backend. Le modèle est minuscule, le CPU suffit largement (~100 ms/segment).
# DIARIZATION_DEVICE=cpu
