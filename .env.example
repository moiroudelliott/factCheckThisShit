MISTRAL_API_KEY=your_api_key_here

# Optionnel — URL de l'instance SearxNG auto-hébergée qui sert la recherche web
# du fact-checker (voir searxng/docker-compose.yml : `docker compose up -d`).
# Doit rester un hôte local : c'est le backend qui interroge SearxNG, jamais un
# moteur tiers qui voit passer les affirmations vérifiées (cf. ARCHITECTURE.md).
# Sans instance joignable, le fact-check tourne sans preuve web (dégradé, pas bloqué).
# SEARXNG_URL=http://127.0.0.1:8080

# Optionnel — jeton partagé entre le backend et l'extension. Sans lui, le
# backend accepte toute connexion locale sans authentification (voir l'audit
# sécurité : bind 127.0.0.1 limite déjà l'exposition au réseau, mais pas aux
# autres onglets/apps du même navigateur). Si défini ici, colle la même
# valeur dans le champ "Jeton d'accès" (section Avancé) de la popup.
# BACKEND_TOKEN=un-secret-long-et-aleatoire

# Optionnel — modèle Whisper (faster-whisper). large-v3-turbo par défaut :
# nettement meilleur que medium sur les chiffres et noms propres, ~6 Go VRAM.
# Repli automatique sur "medium" si le chargement échoue.
# WHISPER_MODEL=large-v3-turbo

# Optionnel — modèle Mistral pour l'extraction de talking points et le
# fact-checking. "medium" suit mieux le prompt d'extraction que "small".
# MISTRAL_MODEL=mistral-medium-latest

# Optionnel — device pour la diarisation (empreintes vocales ECAPA-TDNN).
# "cpu" par défaut : sur GPU, le cuDNN de torch entre en conflit avec celui
# de CTranslate2 (faster-whisper) dans le même process Windows et crash le
# backend. Le modèle est minuscule, le CPU suffit largement (~100 ms/segment).
# DIARIZATION_DEVICE=cpu
