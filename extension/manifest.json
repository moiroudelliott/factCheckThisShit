{
  "manifest_version": 3,
  "name": "SOURCÉ",
  "version": "3.5",
  "description": "Fact-checking en temps réel des débats politiques, sur YouTube et les lecteurs vidéo des chaînes",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen", "activeTab", "scripting", "storage"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.france.tv/*",
    "*://*.francetvinfo.fr/*",
    "*://*.lcp.fr/*",
    "*://*.publicsenat.fr/*",
    "*://*.twitch.tv/*",
    "*://*.dailymotion.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/watch*", "*://*.youtube.com/live/*"],
      "js": ["content.js"],
      "css": ["overlay.css"]
    },
    {
      "matches": [
        "*://*.france.tv/*",
        "*://*.francetvinfo.fr/*",
        "*://*.lcp.fr/*",
        "*://*.publicsenat.fr/*",
        "*://*.twitch.tv/*",
        "*://*.dailymotion.com/*"
      ],
      "js": ["content.js"],
      "css": ["overlay.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
